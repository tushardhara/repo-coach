# ── RepoCoach Configuration ──────────────────────────────
# Copy this to configs/config.env and fill in your values.
# configs/config.env is gitignored — safe to put private repo URLs there.

# The GitHub repo to fine-tune on (REQUIRED)
REPO_URL="https://github.com/you/your-project.git"

# Training pairs generated per source file (higher = more data, slower)
PAIRS_PER_FILE=6

# Caveman mode: explanations in caveman speak, code stays clean
CAVEMAN_MODE=false

# Base model to fine-tune
BASE_MODEL="Qwen/Qwen2.5-Coder-1.5B-Instruct"

# Max parallel Claude Code agents (lower = less RAM contention during training)
MAX_AGENTS=2

# Metal memory fraction (0.75 = 75% of unified memory for MLX; prevents OOM on 18GB)
MLX_METAL_MEMORY_LIMIT=0.75

# Quantization bits for final Ollama export (4 = smallest/fastest)
QUANT_BITS=4

# Minimum changed code files before a retrain actually runs
RETRAIN_MIN_CHANGED_FILES=10
